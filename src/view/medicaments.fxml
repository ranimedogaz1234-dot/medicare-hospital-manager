<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="application.controller.MedicamentController"
      spacing="15" styleClass="page-container">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Gestion des Medicaments" styleClass="page-title">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouveau Medicament" onAction="#handleNewMedicament" styleClass="action-button-primary" prefHeight="40"/>
    </HBox>

    <TableView fx:id="tableMedicaments" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" prefWidth="50" fx:id="colId"/>
            <TableColumn text="Nom" prefWidth="150" fx:id="colNom"/>
            <TableColumn text="Dosage" prefWidth="100" fx:id="colDosage"/>
            <TableColumn text="Indications" prefWidth="250" fx:id="colIndications"/>
            <TableColumn text="Stock" prefWidth="80" fx:id="colStock"/>
            <TableColumn text="Prix (DT)" prefWidth="100" fx:id="colPrix"/>
            <TableColumn text="Actions" prefWidth="150" fx:id="colActions"/>
        </columns>
    </TableView>

    <Label fx:id="lblTotal" text="Total: 0 medicaments" styleClass="info-label"/>
</VBox>

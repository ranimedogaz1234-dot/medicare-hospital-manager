<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="application.controller.DashboardController"
            prefWidth="1200" prefHeight="800">

    <!-- Barre laterale -->
    <left>
        <VBox prefWidth="250" styleClass="sidebar" spacing="5">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="MediCare" styleClass="sidebar-logo">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
                <Label text="HMS" styleClass="sidebar-logo-sub">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Menu -->
            <VBox spacing="5">
                <Button fx:id="btnDashboard" text="Tableau de Bord" onAction="#showDashboard"
                        styleClass="sidebar-button-active" prefWidth="220" prefHeight="45"/>
                <Button fx:id="btnPatients" text="Patients" onAction="#showPatients"
                        styleClass="sidebar-button" prefWidth="220" prefHeight="45"/>
                <Button fx:id="btnMedecins" text="Medecins" onAction="#showMedecins"
                        styleClass="sidebar-button" prefWidth="220" prefHeight="45"/>
                <Button fx:id="btnRendezVous" text="Rendez-vous" onAction="#showRendezVous"
                        styleClass="sidebar-button" prefWidth="220" prefHeight="45"/>
                <Button fx:id="btnDossiers" text="Dossiers Medicaux" onAction="#showDossiers"
                        styleClass="sidebar-button" prefWidth="220" prefHeight="45"/>
                <Button fx:id="btnMedicaments" text="Medicaments" onAction="#showMedicaments"
                        styleClass="sidebar-button" prefWidth="220" prefHeight="45"/>
                <Button fx:id="btnChatbot" text="Assistant MediBot" onAction="#showChatbot"
                        styleClass="sidebar-button" prefWidth="220" prefHeight="45"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator styleClass="sidebar-separator"/>

            <Button text="Deconnexion" onAction="#handleLogout"
                    styleClass="sidebar-button-logout" prefWidth="220" prefHeight="40"/>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <StackPane fx:id="contentPane" styleClass="main-content">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <!-- Vue Dashboard par defaut -->
            <VBox fx:id="dashboardView" spacing="20">
                <Label text="Tableau de Bord" styleClass="page-title">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>

                <!-- Cartes statistiques -->
                <HBox spacing="20">
                    <VBox styleClass="stat-card" prefWidth="200" prefHeight="120" alignment="CENTER" spacing="10">
                        <Label text="PATIENTS" styleClass="stat-label"/>
                        <Label fx:id="lblTotalPatients" text="0" styleClass="stat-value">
                            <font>
                                <Font name="System Bold" size="36"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox styleClass="stat-card" prefWidth="200" prefHeight="120" alignment="CENTER" spacing="10">
                        <Label text="MEDECINS" styleClass="stat-label"/>
                        <Label fx:id="lblTotalMedecins" text="0" styleClass="stat-value">
                            <font>
                                <Font name="System Bold" size="36"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox styleClass="stat-card" prefWidth="200" prefHeight="120" alignment="CENTER" spacing="10">
                        <Label text="RDV AUJOURD'HUI" styleClass="stat-label"/>
                        <Label fx:id="lblRdvToday" text="0" styleClass="stat-value">
                            <font>
                                <Font name="System Bold" size="36"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox styleClass="stat-card" prefWidth="200" prefHeight="120" alignment="CENTER" spacing="10">
                        <Label text="MEDICAMENTS" styleClass="stat-label"/>
                        <Label fx:id="lblTotalMedicaments" text="0" styleClass="stat-value">
                            <font>
                                <Font name="System Bold" size="36"/>
                            </font>
                        </Label>
                    </VBox>
                </HBox>

                <!-- Zone inferieure -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <VBox styleClass="panel-card" HBox.hgrow="ALWAYS" spacing="10">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Rendez-vous du Jour" styleClass="panel-title">
                            <font>
                                <Font name="System Bold" size="16"/>
                            </font>
                        </Label>
                        <TableView fx:id="tableRdvToday" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Heure" prefWidth="80" fx:id="colRdvHeure"/>
                                <TableColumn text="Patient" prefWidth="150" fx:id="colRdvPatient"/>
                                <TableColumn text="Medecin" prefWidth="150" fx:id="colRdvMedecin"/>
                                <TableColumn text="Motif" prefWidth="200" fx:id="colRdvMotif"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox styleClass="panel-card" prefWidth="350" spacing="10">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                        <Label text="Activite Recente" styleClass="panel-title">
                            <font>
                                <Font name="System Bold" size="16"/>
                            </font>
                        </Label>
                        <ListView fx:id="listActivity" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

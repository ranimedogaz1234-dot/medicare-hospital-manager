<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="application.controller.MedecinDialogController"
            prefWidth="450">
    <header>
        <Label text="Medecin" fx:id="dialogTitle" styleClass="dialog-title">
            <font>
                <Font name="System Bold" size="18"/>
            </font>
            <padding>
                <Insets top="15" right="20" bottom="10" left="20"/>
            </padding>
        </Label>
    </header>
    <content>
        <GridPane vgap="10" hgap="15">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNom" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Prenom:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrenom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Specialite:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbSpecialite" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="true"/>

            <Label text="Telephone:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTelephone" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Disponible:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <CheckBox fx:id="chkDisponible" GridPane.rowIndex="5" GridPane.columnIndex="1" selected="true"/>
            <Label text="Email de connexion:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmailConnexion" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <Label text="Mot de passe (12 caractères):" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtPassword" promptText="Laisser vide pour conserver le mot de passe" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        </GridPane>
    </content>
    <buttonTypes>
        <ButtonType text="Enregistrer" buttonData="OK_DONE"/>
        <ButtonType text="Annuler" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>

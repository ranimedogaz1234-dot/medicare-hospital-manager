<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="application.controller.MedecinController"
      spacing="15" styleClass="page-container">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Gestion des Medecins" styleClass="page-title">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouveau Medecin" onAction="#handleNewMedecin" styleClass="action-button-primary" prefHeight="40"/>
    </HBox>

    <TableView fx:id="tableMedecins" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" prefWidth="50" fx:id="colId"/>
            <TableColumn text="Nom" prefWidth="120" fx:id="colNom"/>
            <TableColumn text="Prenom" prefWidth="120" fx:id="colPrenom"/>
            <TableColumn text="Specialite" prefWidth="150" fx:id="colSpecialite"/>
            <TableColumn text="Telephone" prefWidth="120" fx:id="colTelephone"/>
            <TableColumn text="Email" prefWidth="200" fx:id="colEmail"/>
            <TableColumn text="Disponible" prefWidth="100" fx:id="colDisponible"/>
            <TableColumn text="Actions" prefWidth="150" fx:id="colActions"/>
        </columns>
    </TableView>

    <Label fx:id="lblTotal" text="Total: 0 medecins" styleClass="info-label"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="application.controller.DossierController"
      spacing="15" styleClass="page-container">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Dossiers Medicaux" styleClass="page-title">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Rechercher par patient..." prefWidth="250" styleClass="search-field"/>
        <Button text="Nouveau Dossier" onAction="#handleNewDossier" styleClass="action-button-primary" prefHeight="40"/>
    </HBox>

    <TableView fx:id="tableDossiers" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" prefWidth="50" fx:id="colId"/>
            <TableColumn text="Patient" prefWidth="150" fx:id="colPatient"/>
            <TableColumn text="Date Consult." prefWidth="120" fx:id="colDateConsult"/>
            <TableColumn text="Diagnostic" prefWidth="200" fx:id="colDiagnostic"/>
            <TableColumn text="Traitement" prefWidth="200" fx:id="colTraitement"/>
            <TableColumn text="Medecin" prefWidth="150" fx:id="colMedecin"/>
            <TableColumn text="Actions" prefWidth="150" fx:id="colActions"/>
        </columns>
    </TableView>

    <Label fx:id="lblTotal" text="Total: 0 dossiers" styleClass="info-label"/>
</VBox>

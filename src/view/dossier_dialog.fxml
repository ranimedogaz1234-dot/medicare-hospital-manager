<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="application.controller.DossierDialogController"
            prefWidth="500">
    <header>
        <Label text="Dossier Medical" fx:id="dialogTitle" styleClass="dialog-title">
            <font>
                <Font name="System Bold" size="18"/>
            </font>
            <padding>
                <Insets top="15" right="20" bottom="10" left="20"/>
            </padding>
        </Label>
    </header>
    <content>
        <GridPane vgap="10" hgap="15">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Patient:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbPatient" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Date Consult.:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dpDate" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Medecin:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbMedecin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Diagnostic:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtDiagnostic" GridPane.rowIndex="3" GridPane.columnIndex="1" prefRowCount="3" wrapText="true"/>

            <Label text="Traitement:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtTraitement" GridPane.rowIndex="4" GridPane.columnIndex="1" prefRowCount="3" wrapText="true"/>

            <Label text="Notes:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtNotes" GridPane.rowIndex="5" GridPane.columnIndex="1" prefRowCount="2" wrapText="true"/>
        </GridPane>
    </content>
    <buttonTypes>
        <ButtonType text="Enregistrer" buttonData="OK_DONE"/>
        <ButtonType text="Annuler" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>
